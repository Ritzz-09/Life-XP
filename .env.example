# ==============================================================================
# LIFE-XP ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. LOCAL DEVELOPMENT (Default: SQLite)
DATABASE_URL="file:./dev.db"

# 2. PRODUCTION CLOUD DEPLOYMENT (PostgreSQL - Neon / Supabase / Railway)
# For Vercel or cloud multi-user hosting, uncomment and provide your PostgreSQL connection string:
# DATABASE_URL="postgresql://username:password@ep-cool-cloud.neon.tech/lifexp?sslmode=require"

# 3. AUTHENTICATION & SECURITY
JWT_SECRET="super-secret-cryptographic-jwt-token-key-change-this-for-production"
NODE_ENV="development" # Set to "production" when deployed

# 4. OPTIONAL: TRANSACTIONAL EMAIL / NOTIFICATIONS (SMTP / Resend)
# RESEND_API_KEY="your-resend-api-key-here"
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="your-smtp-username"
# SMTP_PASS="your-smtp-password"
# FROM_EMAIL="realm@lifexp.game"

# 5. OPTIONAL: DISTRIBUTED REDIS RATE LIMITING (Upstash Redis)
# UPSTASH_REDIS_REST_URL="https://your-upstash-redis.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
